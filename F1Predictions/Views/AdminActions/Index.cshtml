@{
    ViewData["Title"] = "Admin Actions";
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0"><i class="bi bi-gear-wide-connected me-2"></i>Admin Actions</h2>
        <form asp-controller="AdminAuth" asp-action="Logout" method="post">
            @Html.AntiForgeryToken()
            <button type="submit" class="btn btn-outline-danger">
                <i class="bi bi-box-arrow-right me-1"></i>Logout
            </button>
        </form>
    </div>

    <div class="row g-4">

        @* Race Management *@
        <div class="col-md-4">
            <a asp-action="RaceManagement" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-0" style="transition: transform 0.15s; cursor:pointer;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
                    <div class="card-body text-center py-5">
                        <div class="bg-dark text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                            <i class="bi bi-flag-fill fs-3"></i>
                        </div>
                        <h5 class="card-title">Race Management</h5>
                        <p class="card-text text-muted">Grant points, reset & re-grant, finalize voting for each race.</p>
                    </div>
                </div>
            </a>
        </div>

        @* Tied Predictions *@
        <div class="col-md-4">
            <a asp-action="TiedPredictions" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-0" style="transition: transform 0.15s; cursor:pointer;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
                    <div class="card-body text-center py-5">
                        <div class="bg-warning text-dark rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                            <i class="bi bi-question-circle-fill fs-3"></i>
                        </div>
                        <h5 class="card-title">Tied Predictions</h5>
                        <p class="card-text text-muted">Review and decide on predictions with tied votes.</p>
                    </div>
                </div>
            </a>
        </div>

        @* Pending Reports *@
        <div class="col-md-4">
            <a asp-action="PendingReports" class="text-decoration-none">
                <div class="card shadow-sm h-100 border-0" style="transition: transform 0.15s; cursor:pointer;" onmouseover="this.style.transform='translateY(-4px)'" onmouseout="this.style.transform='none'">
                    <div class="card-body text-center py-5">
                        <div class="bg-danger text-white rounded-circle d-inline-flex align-items-center justify-content-center mb-3" style="width:64px;height:64px;">
                            <i class="bi bi-flag-fill fs-3"></i>
                        </div>
                        <h5 class="card-title">Pending Reports</h5>
                        <p class="card-text text-muted">Review and resolve reported predictions.</p>
                    </div>
                </div>
            </a>
        </div>

    </div>
</div>
