@using F1Predictions.Models
@{
    ViewData["Title"] = "Pending Reports";

    var pendingReports = ViewBag.PendingReports as List<PredictionReport> ?? new List<PredictionReport>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted">
                <i class="bi bi-arrow-left me-1"></i>Back to Admin Actions
            </a>
            <h2 class="mt-2 mb-0"><i class="bi bi-flag-fill me-2"></i>Pending Reports</h2>
        </div>
        <span class="badge bg-danger fs-6">@pendingReports.Count pending</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!pendingReports.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-shield-check" style="font-size: 3rem;"></i>
                <p class="mt-3 mb-0 fs-5">No pending reports</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var report in pendingReports)
            {
                var reportedUser = report.UserPrediction?.User;
                var predType = report.UserPrediction?.WeeklyPrediction?.PredictionType ?? "—";

                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <span class="badge bg-danger">Report #@report.Id</span>
                                <small class="text-muted">@report.CreatedAt.ToString("dd MMM yyyy HH:mm")</small>
                            </div>
                            <p class="mb-1">
                                <i class="bi bi-person-fill text-muted me-1"></i>
                                <strong>Reported by:</strong> @($"{report.Reporter.FirstName} {report.Reporter.LastName}")
                            </p>
                            <p class="mb-1">
                                <i class="bi bi-person-x-fill text-muted me-1"></i>
                                <strong>Prediction by:</strong>
                                @if (reportedUser != null)
                                {
                                    @($"{reportedUser.FirstName} {reportedUser.LastName}")
                                }
                                <span class="badge bg-secondary ms-1">@predType</span>
                            </p>
                            <p class="mb-2">
                                <i class="bi bi-chat-quote-fill text-muted me-1"></i>
                                <em>"@report.Reason"</em>
                            </p>

                            <form asp-action="ResolveReport" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="reportId" value="@report.Id" />
                                <div class="input-group input-group-sm">
                                    <span class="input-group-text"><i class="bi bi-chat-text"></i></span>
                                    <input type="text" name="note" class="form-control" placeholder="Resolution note..." />
                                    <button type="submit" class="btn btn-outline-success"
                                            onclick="return confirm('Resolve this report?')">
                                        <i class="bi bi-check-lg me-1"></i>Resolve
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
