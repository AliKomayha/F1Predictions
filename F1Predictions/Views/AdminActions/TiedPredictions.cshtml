@using F1Predictions.Models
@{
    ViewData["Title"] = "Tied Predictions";

    var tiedPredictions = ViewBag.TiedPredictions as List<UserPrediction> ?? new List<UserPrediction>();
}

<div class="container py-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <a asp-action="Index" class="text-decoration-none text-muted">
                <i class="bi bi-arrow-left me-1"></i>Back to Admin Actions
            </a>
            <h2 class="mt-2 mb-0"><i class="bi bi-question-circle-fill me-2"></i>Tied Predictions</h2>
        </div>
        <span class="badge bg-warning text-dark fs-6">@tiedPredictions.Count pending</span>
    </div>

    @if (TempData["SuccessMessage"] != null)
    {
        <div class="alert alert-success alert-dismissible fade show" role="alert">
            <i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }
    @if (TempData["ErrorMessage"] != null)
    {
        <div class="alert alert-danger alert-dismissible fade show" role="alert">
            <i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]
            <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
        </div>
    }

    @if (!tiedPredictions.Any())
    {
        <div class="card shadow-sm">
            <div class="card-body text-center text-muted py-5">
                <i class="bi bi-check-circle" style="font-size: 3rem;"></i>
                <p class="mt-3 mb-0 fs-5">No tied predictions to resolve</p>
            </div>
        </div>
    }
    else
    {
        <div class="row g-3">
            @foreach (var pred in tiedPredictions)
            {
                var yesVotes = pred.Votes.Count(v => v.Vote);
                var noVotes = pred.Votes.Count(v => !v.Vote);
                var predContent = pred.TargetType switch
                {
                    "Driver" => pred.Driver != null ? $"{pred.Driver.FirstName} {pred.Driver.LastName}" : "Unknown",
                    "Team" => pred.Team?.DisplayName ?? "Unknown",
                    _ => pred.Text ?? "—"
                };

                <div class="col-md-6">
                    <div class="card shadow-sm">
                        <div class="card-body">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <div>
                                    <span class="badge bg-secondary me-1">@pred.WeeklyPrediction.PredictionType</span>
                                    <span class="badge bg-info">@pred.TargetType</span>
                                </div>
                                <small class="text-muted">
                                    <i class="bi bi-hand-thumbs-up-fill text-success"></i> @yesVotes
                                    <i class="bi bi-hand-thumbs-down-fill text-danger ms-2"></i> @noVotes
                                </small>
                            </div>
                            <p class="mb-1">
                                <strong>@($"{pred.User.FirstName} {pred.User.LastName}")</strong>
                                <span class="text-muted">(@pred.League.Name)</span>
                            </p>
                            <p class="mb-2">@predContent</p>

                            <form asp-action="AdminDecide" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="userPredictionId" value="@pred.Id" />
                                <div class="input-group input-group-sm mb-2">
                                    <span class="input-group-text"><i class="bi bi-chat-text"></i></span>
                                    <input type="text" name="note" class="form-control" placeholder="Optional note..." />
                                </div>
                                <div class="btn-group btn-group-sm w-100">
                                    <button type="submit" name="isApproved" value="true" class="btn btn-success">
                                        <i class="bi bi-check-lg me-1"></i>Approve
                                    </button>
                                    <button type="submit" name="isApproved" value="false" class="btn btn-danger">
                                        <i class="bi bi-x-lg me-1"></i>Deny
                                    </button>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
