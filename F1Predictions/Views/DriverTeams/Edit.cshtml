@model DriverTeam

@{
    ViewData["Title"] = "Edit Driver Assignment";
    var drivers = ViewBag.Drivers as SelectList;
    var teams = ViewBag.Teams as SelectList;
    var championships = ViewBag.Championships as SelectList;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0">
                        <i class="bi bi-pencil-square me-2"></i>Edit Driver Assignment
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="ChampionshipId" class="form-label fw-semibold">
                                <i class="bi bi-trophy me-1"></i>Championship Season <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ChampionshipId" class="form-select" asp-items="@championships">
                                <option value="">-- Select Championship --</option>
                            </select>
                            <span asp-validation-for="ChampionshipId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="TeamId" class="form-label fw-semibold">
                                <i class="bi bi-flag me-1"></i>Team <span class="text-danger">*</span>
                            </label>
                            <select asp-for="TeamId" class="form-select" asp-items="@teams">
                                <option value="">-- Select Team --</option>
                            </select>
                            <span asp-validation-for="TeamId" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="DriverId" class="form-label fw-semibold">
                                <i class="bi bi-person me-1"></i>Driver <span class="text-danger">*</span>
                            </label>
                            <select asp-for="DriverId" class="form-select" asp-items="@drivers">
                                <option value="">-- Select Driver --</option>
                            </select>
                            <span asp-validation-for="DriverId" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-1"></i>Update Assignment
                            </button>
                            <a asp-action="Index" asp-route-championshipId="@Model.ChampionshipId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back to Lineups
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
