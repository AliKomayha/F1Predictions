@model DriverTeam

@{
    ViewData["Title"] = "Driver Assignment Details";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-info text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-badge me-2"></i>Driver Assignment Details
                    </h4>
                </div>
                <div class="card-body">
                    <div class="text-center mb-4">
                        <div class="d-flex justify-content-center align-items-center gap-3">
                            <!-- Driver Avatar -->
                            <div class="bg-danger rounded-circle d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px;">
                                <span class="text-white fw-bold">@Model.Driver.FirstName[0]@Model.Driver.LastName[0]</span>
                            </div>
                            <i class="bi bi-arrow-right fs-3 text-muted"></i>
                            <!-- Team Icon -->
                            <div class="bg-primary rounded-circle d-flex align-items-center justify-content-center" 
                                 style="width: 60px; height: 60px;">
                                <i class="bi bi-flag text-white fs-4"></i>
                            </div>
                        </div>
                        <h4 class="mt-3 mb-1">@Model.Driver.FirstName @Model.Driver.LastName</h4>
                        <p class="text-muted mb-0">driving for <strong>@Model.Team.DisplayName</strong></p>
                    </div>

                    <hr />

                    <dl class="row mb-0">
                        <dt class="col-sm-4 text-muted">Assignment ID</dt>
                        <dd class="col-sm-8">@Model.Id</dd>

                        <dt class="col-sm-4 text-muted">Championship</dt>
                        <dd class="col-sm-8">
                            <span class="badge bg-dark">@Model.Championship.Name (@Model.Championship.Year)</span>
                        </dd>

                        <dt class="col-sm-4 text-muted">Team</dt>
                        <dd class="col-sm-8">@Model.Team.Name</dd>

                        <dt class="col-sm-4 text-muted">Display Name</dt>
                        <dd class="col-sm-8">@Model.Team.DisplayName</dd>

                        <dt class="col-sm-4 text-muted">Driver</dt>
                        <dd class="col-sm-8">@Model.Driver.FirstName @Model.Driver.LastName</dd>

                        <dt class="col-sm-4 text-muted">Driver Number</dt>
                        <dd class="col-sm-8">#@Model.Driver.ChampionshipNumber</dd>

                        <dt class="col-sm-4 text-muted">Nationality</dt>
                        <dd class="col-sm-8">@(Model.Driver.Nationality ?? "Not specified")</dd>
                    </dl>
                </div>
                <div class="card-footer bg-light">
                    <div class="d-flex gap-2">
                        <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">
                            <i class="bi bi-pencil me-1"></i>Edit
                        </a>
                        <a asp-action="Index" asp-route-championshipId="@Model.ChampionshipId" class="btn btn-outline-secondary">
                            <i class="bi bi-arrow-left me-1"></i>Back to Lineups
                        </a>
                        <button type="button" class="btn btn-outline-danger ms-auto" 
                                data-bs-toggle="modal" data-bs-target="#deleteModal">
                            <i class="bi bi-trash me-1"></i>Remove
                        </button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Delete Confirmation Modal -->
<div class="modal fade" id="deleteModal" tabindex="-1" aria-labelledby="deleteModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title" id="deleteModalLabel">
                    <i class="bi bi-exclamation-triangle me-2"></i>Remove Driver Assignment
                </h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body">
                <p class="mb-0">
                    Are you sure you want to remove <strong>@Model.Driver.FirstName @Model.Driver.LastName</strong> 
                    from <strong>@Model.Team.DisplayName</strong> for the @Model.Championship.Year season?
                </p>
                <p class="text-muted small mb-0 mt-2">This action cannot be undone.</p>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="Delete" asp-route-id="@Model.Id" asp-route-championshipId="@Model.ChampionshipId" method="post" class="d-inline">
                    <button type="submit" class="btn btn-danger">
                        <i class="bi bi-trash me-1"></i>Remove
                    </button>
                </form>
            </div>
        </div>
    </div>
</div>
