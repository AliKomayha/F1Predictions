@model Driver

@{
    ViewData["Title"] = "Add Driver";
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0">
                        <i class="bi bi-person-plus me-2"></i>Add New Driver
                    </h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <div class="mb-3">
                            <label asp-for="FirstName" class="form-label fw-semibold">
                                First Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="FirstName" class="form-control" placeholder="e.g., Lewis" />
                            <span asp-validation-for="FirstName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="LastName" class="form-label fw-semibold">
                                Last Name <span class="text-danger">*</span>
                            </label>
                            <input asp-for="LastName" class="form-control" placeholder="e.g., Hamilton" />
                            <span asp-validation-for="LastName" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ChampionshipNumber" class="form-label fw-semibold">
                                Championship Number <span class="text-danger">*</span>
                            </label>
                            <input asp-for="ChampionshipNumber" type="number" class="form-control" 
                                   min="0" max="99" placeholder="e.g., 44" />
                            <span asp-validation-for="ChampionshipNumber" class="text-danger small"></span>
                            <div class="form-text">The driver's race number (0-99)</div>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Nationality" class="form-label fw-semibold">Nationality</label>
                            <input asp-for="Nationality" class="form-control" placeholder="e.g., British" />
                            <span asp-validation-for="Nationality" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Save Driver
                            </button>
                            <a asp-action="Index" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
