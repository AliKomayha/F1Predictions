@using F1Predictions.Controllers
@{
    ViewData["Title"] = "Dashboard";
    var championships = ViewBag.Championships as SelectList;
    var selectedChampionshipId = ViewBag.SelectedChampionshipId as int?;
    var selectedChampionship = ViewBag.SelectedChampionship as Championship;
    var driverStandings = ViewBag.DriverStandings as List<DriverStandingViewModel>;
    var constructorStandings = ViewBag.ConstructorStandings as List<ConstructorStandingViewModel>;
    var upcomingRaces = ViewBag.UpcomingRaces as List<Race>;
    var recentResults = ViewBag.RecentResults as List<SessionResult>;
}

<div class="container py-4">
    <!-- Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="h2 mb-0">
                <i class="bi bi-speedometer2 me-2"></i>F1 Admin Dashboard
            </h1>
            <p class="text-muted mb-0">Championship management and tracking</p>
        </div>
    </div>

    <!-- Championship Selector -->
    <div class="card shadow-sm mb-4 border-0 bg-dark text-white">
        <div class="card-body">
            <form method="get" class="row g-3 align-items-end">
                <div class="col-md-8">
                    <label for="championshipId" class="form-label fw-semibold">
                        <i class="bi bi-trophy-fill me-1 text-warning"></i>Select Championship Season
                    </label>
                    <select name="championshipId" id="championshipId" class="form-select form-select-lg" onchange="this.form.submit()">
                        @if (championships != null)
                        {
                            @foreach (var item in championships.Items.Cast<Championship>())
                            {
                                <option value="@item.Id" selected="@(selectedChampionshipId == item.Id)">
                                    @item.Name (@item.Year)
                                </option>
                            }
                        }
                    </select>
                </div>
                <div class="col-md-4">
                    <button type="submit" class="btn btn-warning btn-lg w-100">
                        <i class="bi bi-arrow-repeat me-1"></i>Load Season
                    </button>
                </div>
            </form>
        </div>
    </div>

    <!-- Stats Cards -->
    <div class="row g-4 mb-4">
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-primary text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-person-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalDrivers</h3>
                        <small>Drivers</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-danger text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-building fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalTeams</h3>
                        <small>Teams</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-success text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-flag-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalRaces</h3>
                        <small>Races</small>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-md-3">
            <div class="card border-0 shadow-sm h-100 bg-info text-white">
                <div class="card-body d-flex align-items-center">
                    <div class="bg-white bg-opacity-25 rounded-circle p-3 me-3">
                        <i class="bi bi-stopwatch-fill fs-3"></i>
                    </div>
                    <div>
                        <h3 class="mb-0">@ViewBag.TotalSessions</h3>
                        <small>Sessions</small>
                    </div>
                </div>
            </div>
        </div>
    </div>

    @if (selectedChampionshipId.HasValue)
    {
        <div class="row g-4">
            <!-- Driver Standings -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-trophy-fill text-warning me-2"></i>Driver Standings</h5>
                        @if (selectedChampionship != null)
                        {
                            <span class="badge bg-warning text-dark">@selectedChampionship.Year</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        @if (driverStandings != null && driverStandings.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center" style="width: 50px;">Pos</th>
                                            <th>Driver</th>
                                            <th>Team</th>
                                            <th class="text-center">W</th>
                                            <th class="text-center">Pts</th>
                                        </tr>
                                    </thead>
                                    <tbody id="driverStandingsBody">
                                        @{ var driverIndex = 0; }
                                        @foreach (var driver in driverStandings)
                                        {
                                            driverIndex++;
                                            var posClass = driver.Position switch
                                            {
                                                1 => "bg-warning text-dark",
                                                2 => "bg-secondary text-white",
                                                3 => "bg-danger text-white",
                                                _ => "bg-light text-dark"
                                            };
                                            var hiddenClass = driverIndex > 10 ? "driver-row-hidden d-none" : "";
                                            <tr class="@hiddenClass">
                                                <td class="text-center">
                                                    <span class="badge @posClass">@driver.Position</span>
                                                </td>
                                                <td>
                                                    <span class="fw-semibold">@driver.DriverName</span>
                                                    <small class="text-muted ms-1">#@driver.DriverNumber</small>
                                                </td>
                                                <td><small class="text-muted">@driver.TeamName</small></td>
                                                <td class="text-center">
                                                    @if (driver.Wins > 0)
                                                    {
                                                        <span class="badge bg-success">@driver.Wins</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center"><strong>@driver.TotalPoints</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                            @if (driverStandings.Count > 10)
                            {
                                <div class="card-footer bg-light text-center">
                                    <button type="button" class="btn btn-outline-dark btn-sm" id="toggleDriversBtn" onclick="toggleDriverStandings()">
                                        <i class="bi bi-chevron-down me-1" id="toggleDriversIcon"></i>
                                        <span id="toggleDriversText">Show More (@(driverStandings.Count - 10) more)</span>
                                    </button>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-2">No standings data yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Constructor Standings -->
            <div class="col-lg-6">
                <div class="card shadow-sm h-100">
                    <div class="card-header bg-dark text-white d-flex justify-content-between align-items-center">
                        <h5 class="mb-0"><i class="bi bi-building-fill text-info me-2"></i>Constructor Standings</h5>
                        @if (selectedChampionship != null)
                        {
                            <span class="badge bg-info">@selectedChampionship.Year</span>
                        }
                    </div>
                    <div class="card-body p-0">
                        @if (constructorStandings != null && constructorStandings.Any())
                        {
                            <div class="table-responsive">
                                <table class="table table-hover mb-0 align-middle">
                                    <thead class="table-light">
                                        <tr>
                                            <th class="text-center" style="width: 50px;">Pos</th>
                                            <th>Team</th>
                                            <th class="text-center">Wins</th>
                                            <th class="text-center">Pts</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @foreach (var team in constructorStandings)
                                        {
                                            var posClass = team.Position switch
                                            {
                                                1 => "bg-warning text-dark",
                                                2 => "bg-secondary text-white",
                                                3 => "bg-danger text-white",
                                                _ => "bg-light text-dark"
                                            };
                                            <tr>
                                                <td class="text-center">
                                                    <span class="badge @posClass">@team.Position</span>
                                                </td>
                                                <td class="fw-semibold">@team.TeamName</td>
                                                <td class="text-center">
                                                    @if (team.Wins > 0)
                                                    {
                                                        <span class="badge bg-success">@team.Wins</span>
                                                    }
                                                    else
                                                    {
                                                        <span class="text-muted">-</span>
                                                    }
                                                </td>
                                                <td class="text-center"><strong>@team.TotalPoints</strong></td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-inbox display-4"></i>
                                <p class="mt-2">No standings data yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>

        <div class="row g-4 mt-2">
            <!-- Upcoming Races -->
            <div class="col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-success text-white">
                        <h5 class="mb-0"><i class="bi bi-calendar-event me-2"></i>Upcoming Races</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (upcomingRaces != null && upcomingRaces.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var race in upcomingRaces)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-danger me-2">R@race.RoundNumber</span>
                                            <span class="fw-semibold">@race.RaceName</span>
                                            <br />
                                            <small class="text-muted"><i class="bi bi-geo-alt me-1"></i>@race.Track.Name</small>
                                        </div>
                                        <span class="badge bg-secondary">@race.RaceDate.ToString("dd MMM")</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-calendar-x display-4"></i>
                                <p class="mt-2">No upcoming races</p>
                            </div>
                        }
                    </div>
                </div>
            </div>

            <!-- Recent Winners -->
            <div class="col-lg-6">
                <div class="card shadow-sm">
                    <div class="card-header bg-warning">
                        <h5 class="mb-0"><i class="bi bi-trophy me-2"></i>Recent Winners</h5>
                    </div>
                    <div class="card-body p-0">
                        @if (recentResults != null && recentResults.Any())
                        {
                            <ul class="list-group list-group-flush">
                                @foreach (var result in recentResults)
                                {
                                    <li class="list-group-item d-flex justify-content-between align-items-center">
                                        <div>
                                            <span class="badge bg-warning text-dark me-2">P1</span>
                                            <span class="fw-semibold">@result.Driver.FirstName @result.Driver.LastName</span>
                                            <br />
                                            <small class="text-muted">
                                                @result.Session.Race.RaceName - @result.Session.Type
                                            </small>
                                        </div>
                                        <span class="badge bg-success">+@result.Points pts</span>
                                    </li>
                                }
                            </ul>
                        }
                        else
                        {
                            <div class="text-center py-4 text-muted">
                                <i class="bi bi-emoji-smile display-4"></i>
                                <p class="mt-2">No results yet</p>
                            </div>
                        }
                    </div>
                </div>
            </div>
        </div>
    }
    else
    {
        <div class="card shadow-sm">
            <div class="card-body text-center py-5">
                <i class="bi bi-graph-up-arrow display-1 text-muted mb-3"></i>
                <h4 class="text-muted">Select a Championship</h4>
                <p class="text-muted mb-0">Choose a championship season above to view standings and statistics.</p>
            </div>
        </div>
    }

    <!-- Quick Links -->
    <div class="card shadow-sm mt-4">
        <div class="card-header bg-light">
            <h5 class="mb-0"><i class="bi bi-lightning-fill text-warning me-2"></i>Quick Actions</h5>
        </div>
        <div class="card-body">
            <div class="row g-3">
                <div class="col-md-3">
                    <a asp-controller="Drivers" asp-action="Create" class="btn btn-outline-primary w-100">
                        <i class="bi bi-person-plus me-1"></i>Add Driver
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="Teams" asp-action="Create" class="btn btn-outline-danger w-100">
                        <i class="bi bi-building-add me-1"></i>Add Team
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="Races" asp-action="Create" class="btn btn-outline-success w-100">
                        <i class="bi bi-calendar-plus me-1"></i>Add Race
                    </a>
                </div>
                <div class="col-md-3">
                    <a asp-controller="Sessions" asp-action="Index" class="btn btn-outline-info w-100">
                        <i class="bi bi-stopwatch me-1"></i>Manage Sessions
                    </a>
                </div>
            </div>
        </div>
</div>
</div>

@section Scripts {
    <script>
        function toggleDriverStandings() {
            const hiddenRows = document.querySelectorAll('.driver-row-hidden');
            const toggleBtn = document.getElementById('toggleDriversBtn');
            const toggleIcon = document.getElementById('toggleDriversIcon');
            const toggleText = document.getElementById('toggleDriversText');
            
            const isHidden = hiddenRows.length > 0 && hiddenRows[0].classList.contains('d-none');
            
            hiddenRows.forEach(row => {
                if (isHidden) {
                    row.classList.remove('d-none');
                } else {
                    row.classList.add('d-none');
                }
            });
            
            if (isHidden) {
                toggleIcon.classList.remove('bi-chevron-down');
                toggleIcon.classList.add('bi-chevron-up');
                toggleText.textContent = 'Show Less';
            } else {
                toggleIcon.classList.remove('bi-chevron-up');
                toggleIcon.classList.add('bi-chevron-down');
                toggleText.textContent = 'Show More (' + hiddenRows.length + ' more)';
            }
        }
    </script>
}
