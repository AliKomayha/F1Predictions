@model PointsSystem

@{
    ViewData["Title"] = "Edit Points Entry";
    var championships = ViewBag.Championships as SelectList;
    var sessionTypes = ViewBag.SessionTypes as SelectList;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-5 col-md-7">
            <div class="card shadow-sm">
                <div class="card-header bg-warning">
                    <h4 class="mb-0"><i class="bi bi-pencil-square me-2"></i>Edit Points Entry</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Edit" method="post">
                        <input type="hidden" asp-for="Id" />

                        <div class="mb-3">
                            <label asp-for="ChampionshipId" class="form-label fw-semibold">
                                Championship <span class="text-danger">*</span>
                            </label>
                            <select asp-for="ChampionshipId" class="form-select" asp-items="@championships">
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                        <div class="mb-3">
                            <label asp-for="SessionType" class="form-label fw-semibold">
                                Session Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="SessionType" class="form-select" asp-items="@sessionTypes">
                                <option value="">-- Select --</option>
                            </select>
                        </div>

                        <div class="row">
                            <div class="col-6 mb-3">
                                <label asp-for="Position" class="form-label fw-semibold">Position</label>
                                <input asp-for="Position" type="number" class="form-control" min="0" max="20" />
                            </div>
                            <div class="col-6 mb-3">
                                <label asp-for="Points" class="form-label fw-semibold">Points</label>
                                <input asp-for="Points" type="number" step="0.5" class="form-control" min="0" />
                            </div>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-warning">
                                <i class="bi bi-check-lg me-1"></i>Update
                            </button>
                            <a asp-action="Index" asp-route-championshipId="@Model.ChampionshipId" class="btn btn-outline-secondary">
                                <i class="bi bi-arrow-left me-1"></i>Back
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
