@model Session

@{
    ViewData["Title"] = "Add Session";
    var races = ViewBag.Races as SelectList;
    var sessionTypes = ViewBag.SessionTypes as SelectList;
}

<div class="container py-4">
    <div class="row justify-content-center">
        <div class="col-lg-6 col-md-8">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white">
                    <h4 class="mb-0"><i class="bi bi-stopwatch me-2"></i>Add Session</h4>
                </div>
                <div class="card-body">
                    <form asp-action="Create" method="post">
                        <input type="hidden" asp-for="ChampionshipId" />

                        <div class="mb-3">
                            <label asp-for="RaceId" class="form-label fw-semibold">
                                Race Weekend <span class="text-danger">*</span>
                            </label>
                            <select asp-for="RaceId" class="form-select" asp-items="@races">
                                <option value="">-- Select Race --</option>
                            </select>
                            <span asp-validation-for="RaceId" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Type" class="form-label fw-semibold">
                                Session Type <span class="text-danger">*</span>
                            </label>
                            <select asp-for="Type" class="form-select" asp-items="@sessionTypes">
                                <option value="">-- Select Type --</option>
                            </select>
                            <span asp-validation-for="Type" class="text-danger small"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="DateTime" class="form-label fw-semibold">
                                Date & Time <span class="text-danger">*</span>
                            </label>
                            <input asp-for="DateTime" type="datetime-local" class="form-control" />
                            <span asp-validation-for="DateTime" class="text-danger small"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="Laps" class="form-label fw-semibold">
                                Laps <small class="text-muted">(for Race/Sprint only)</small>
                            </label>
                            <input asp-for="Laps" type="number" class="form-control" min="1" max="80" placeholder="e.g., 57" />
                            <span asp-validation-for="Laps" class="text-danger small"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit" class="btn btn-primary">
                                <i class="bi bi-check-lg me-1"></i>Save
                            </button>
                            <a asp-action="Index" asp-route-raceId="@Model.RaceId" class="btn btn-outline-secondary">
                                <i class="bi bi-x-lg me-1"></i>Cancel
                            </a>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
